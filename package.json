{
  "name": "cv-improvement",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:server": "node build-server.js",
    "build-exe": "npm run build && npm run build:server && npx electron-builder",
    "test": "node scripts/run-tests.mjs unit",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:api": "npm run build:server && node scripts/run-tests.mjs integration",
    "test:quality": "npm run test:unit && npm run test:api",
    "project:plan": "node scripts/bootstrap-github-project.mjs",
    "project:apply": "node scripts/bootstrap-github-project.mjs --apply"
  },
  "build": {
    "appId": "com.cv.improvement",
    "productName": "CV Improvement",
    "artifactName": "CV Improvement Setup ${version}.${ext}",
    "electronVersion": "30.0.0",
    "files": [
      "dist/**/*",
      "main.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/cv-improvement.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CV Improvement",
      "deleteAppDataOnUninstall": false,
      "include": "build/deltaone-installer.nsh",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "displayLanguageSelector": false,
      "installerIcon": "build/cv-improvement.ico",
      "uninstallerIcon": "build/cv-improvement.ico",
      "installerHeaderIcon": "build/cv-improvement.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp"
    },
    "copyright": "Copyright © 2026 DeltaOne Developpement",
    "extraResources": [
      {
        "from": "build/cv-improvement.ico",
        "to": "cv-improvement.ico"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/marked": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "author": {
    "name": "DeltaOne Developpement"
  },
  "description": "CV Improvement - by DeltaOne Developpement. Direction de projet : François Delrieu."
}
